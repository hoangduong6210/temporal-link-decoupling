__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
resources/corpora/*.npz
resources/corpora/pre_idfix/*.npz
resources/corpora/legacy_migration/*.npz
resources/staging/
paper/working/*.zip
results/audit/*
!results/audit/.gitkeep
# The parent monorepo ignores every directory named ``datasets``.  Canonical
# wiki source is text, not a downloaded dataset, and must survive clean clones.
!wiki/datasets/
!wiki/datasets/*.md
# Frozen releases and paper snapshots are immutable, reviewable records. Keep
# them trackable; large payloads may instead be represented by a tracked
# manifest containing an immutable URI and checksum.
